SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Where cancellations and Feedback & Support submissions get emailed. Leave blank in dev.
OWNER_NOTIFY_EMAIL=

# Real email delivery (production only - leave EMAIL_BACKEND as the console
# one above for local dev). Goes through Resend's HTTP API, not SMTP - some
# hosts (Render's free plan included) silently block outbound SMTP, so the
# HTTP API is the one that actually works everywhere. Set up:
#   1. Sign up at resend.com, create an API key.
#   2. Set EMAIL_BACKEND=common.email_backend.ResendBackend
#   3. Paste the API key below as EMAIL_HOST_PASSWORD.
#   4. Once your real domain is bought and verified in Resend, update
#      DEFAULT_FROM_EMAIL to send from it instead of onboarding@resend.dev.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MellaX <onboarding@resend.dev>

# Private-demo gate: while set, signup requires this exact code (see
# accounts/serializers.py). Leave blank for open public signup.
SIGNUP_INVITE_CODE=
