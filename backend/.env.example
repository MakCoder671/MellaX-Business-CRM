SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Where cancellations and Feedback & Support submissions get emailed. Leave blank in dev.
OWNER_NOTIFY_EMAIL=

# Real email delivery (production only - leave EMAIL_BACKEND as the console
# one above for local dev). Set up for Resend's SMTP relay by default:
#   1. Sign up at resend.com, create an API key.
#   2. Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   3. Paste the API key below as EMAIL_HOST_PASSWORD.
#   4. Once your real domain is bought and verified in Resend, update
#      DEFAULT_FROM_EMAIL to send from it instead of onboarding@resend.dev.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MellaX <onboarding@resend.dev>
